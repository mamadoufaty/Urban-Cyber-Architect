# Database (SQLite par défaut — pas de Docker/PostgreSQL requis en local)
DATABASE_URL=sqlite+aiosqlite:///./urban_cyber_architect.db

# PostgreSQL (Docker / prod) — décommenter et remplacer l'URL ci-dessus :
# DATABASE_URL=postgresql+asyncpg://uca:uca@localhost:5432/urban_cyber_architect

# Debug
DEBUG=true

# LLM Providers (optional — mocks used when absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434
